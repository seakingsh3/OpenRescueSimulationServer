[Unit]
Description=OpenRescueSim Raumlautsprecher (Voice of Room)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/ors-speaker/ors-speaker.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# Läuft als root, damit „Neustart“ aus der Oberfläche funktioniert und ALSA ohne Gruppenpflege nutzbar ist.
# Wer das nicht möchte: User=pi, SupplementaryGroups=audio und allow_reboot = no in der Konfiguration.
StateDirectory=ors-speaker

[Install]
WantedBy=multi-user.target
